events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      '';
    }
    sendfile      on;
    keepalive_timeout 65;
    server_tokens off;
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/javascript image/svg+xml;
    gzip_min_length 1000;
    gzip_vary on;

    # Rate limits
    # eh_proxy runs before require_auth, so it is the only gate against an
    # unauthenticated flood reaching API workers -- keep the zone even though
    # its per-key granularity is coarse. No real_ip_header is configured, so
    # $binary_remote_addr resolves to the outer reverse proxy's address, not
    # the end client's; this is a shared bucket across all external clients,
    # not a per-user limit.
    limit_req_zone $binary_remote_addr zone=eh_proxy:10m rate=30r/s;
    limit_req_zone $binary_remote_addr zone=pixiv_proxy:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=auth_zone:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=api_zone:10m rate=30r/s;
    limit_req_zone $binary_remote_addr zone=download_zone:10m rate=2r/s;
    limit_req_zone $binary_remote_addr zone=opds_zone:10m rate=10r/s;

    # Nginx proxy cache for EH thumbnail CDN images
    proxy_cache_path /var/cache/nginx/thumb_cache levels=1:2 keys_zone=thumb_cache:10m
                     max_size=512m inactive=7d use_temp_path=off;

    # Dynamic AVIF/WebP variants generated by imgproxy.
    proxy_cache_path /var/cache/nginx/image_cache levels=1:2 keys_zone=image_cache:20m
                     max_size=2g inactive=30d use_temp_path=off;

    # Auth subrequest cache — cache auth results for 5 minutes per cookie
    proxy_cache_path /var/cache/nginx/auth_cache levels=1:2 keys_zone=auth_cache:1m
                     max_size=10m inactive=5m use_temp_path=off;

    upstream api {
        server api:8000;
        keepalive 32;
    }

    server {
        listen 80;
        server_name _;

        # ── Security headers ──────────────────────────────────────
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' wss:; font-src 'self'; frame-ancestors 'none';" always;

        # ── Internal auth endpoint (used by auth_request) ─────────
        location = /_auth {
            internal;
            proxy_pass http://api/api/auth/check;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Authorization $http_authorization;

            # Cache auth results per cookie+authorization value. 200 is kept
            # short: it bounds how long a revoked session (logout, role change,
            # disabled user) can still fetch /media/* (edge case audit #66).
            # auth/check is a single Redis GET, so the extra subrequest QPS
            # from the shorter TTL is cheap.
            proxy_cache auth_cache;
            proxy_cache_key $http_cookie$http_authorization;
            proxy_cache_valid 200 30s;
            proxy_cache_valid 401 403 10s;
        }

        # ── Internal auth endpoint for URI-addressed media ────────
        # /media/libraries/ and /media/image/ carry a path-scoped 403 from
        # /api/auth/check (X-Original-URI-based gallery/imgproxy-prefix
        # authorization, see backend/services/media_authz.py). The plain
        # /_auth cache above keys only on cookie+authorization, so a cached
        # 200 from one URI (e.g. a gallery the user can read) would be
        # replayed for any other URI under the same location — including one
        # that should be 403 (audit #67/#68). Keying on $request_uri as well
        # keeps each path's decision isolated. $request_uri inside an
        # auth_request subrequest is still the original request's URI, not
        # /_auth_media's own, so this is safe to use as a cache key here.
        location = /_auth_media {
            internal;
            proxy_pass http://api/api/auth/check;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header X-Original-URI $request_uri;
            proxy_set_header Authorization $http_authorization;

            proxy_cache auth_cache;
            proxy_cache_key $http_cookie$http_authorization$request_uri;
            proxy_cache_valid 200 30s;
            proxy_cache_valid 401 403 10s;
        }

        # ── Media: require auth via subrequest ────────────────────
        # cas/thumbs use the session-only /_auth: routers/auth.py only applies
        # URI authorization to /media/libraries/ and /media/image/, so keying
        # these on $request_uri bought no authorization — it just gave every
        # distinct sha256 URL its own auth cache entry, turning one cached
        # session check per 30s into one API subrequest per image.
        location /media/thumbs/ {
            auth_request /_auth;
            alias /data/thumbs/;
            disable_symlinks on;
            expires 7d;
            add_header Cache-Control "private, immutable";
            add_header X-Content-Type-Options "nosniff" always;
        }

        location /media/cas/ {
            auth_request /_auth;
            alias /data/cas/;
            disable_symlinks on;
            expires 30d;
            add_header Cache-Control "private, immutable";
            add_header X-Content-Type-Options "nosniff" always;
        }

        location /media/image/ {
            auth_request /_auth_media;
            proxy_pass http://imgproxy:8080/;
            proxy_cache image_cache;
            proxy_cache_key $uri;
            proxy_cache_valid 200 30d;
            proxy_cache_valid 404 1m;
            proxy_cache_lock on;
            expires 30d;
            add_header Cache-Control "private, immutable";
            add_header X-Image-Cache $upstream_cache_status always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        location /media/avatars/ {
            auth_request /_auth;
            alias /data/avatars/;
            disable_symlinks on;
            expires 1d;
            add_header Cache-Control "private";
            add_header X-Content-Type-Options "nosniff" always;
        }

        location /media/libraries/ {
            auth_request /_auth_media;
            alias /mnt/;
            disable_symlinks on;
            expires 1d;
            add_header Cache-Control "private";
            add_header X-Content-Type-Options "nosniff" always;
        }

        # ── Auth endpoints: rate limited ──────────────────────────
        location /api/auth/login {
            limit_req zone=auth_zone burst=3 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api/auth/setup {
            limit_req zone=auth_zone burst=2 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ── E-H thumbnail proxy: Nginx-cached ────────────────────
        location /api/eh/thumb-proxy {
            proxy_cache thumb_cache;
            proxy_cache_valid 200 7d;
            proxy_cache_use_stale error timeout updating;
            proxy_cache_key $request_uri;
            add_header X-Cache-Status $upstream_cache_status;

            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ── E-H image proxy: rate limited ─────────────────────────
        location /api/eh/image-proxy/ {
            limit_req zone=eh_proxy burst=60 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 60s;
        }

        # ── Pixiv image proxy: Nginx-cached, dedicated rate zone ──
        # Ranking/browse grids fire many pximg thumbnails at once; keep them
        # off api_zone (shared with polling) and serve repeats from cache.
        # pximg URLs are content-addressed + immutable, so cache by ?url=.
        location /api/pixiv/image-proxy {
            proxy_cache thumb_cache;
            proxy_cache_valid 200 7d;
            proxy_cache_use_stale error timeout updating;
            proxy_cache_key $arg_url;
            add_header X-Cache-Status $upstream_cache_status;

            limit_req zone=pixiv_proxy burst=80 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 60s;
        }

        # ── Download status endpoints: use api_zone (no strict limit) ──
        location ~ ^/api/download/(jobs|stats|supported-sites|check-url) {
            limit_req zone=api_zone burst=60 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ── Download enqueue / control: rate limited ─────────────────────
        location /api/download/ {
            limit_req zone=download_zone burst=10 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # ── API + WebSocket ───────────────────────────────────────
        location /api/ {
            limit_req zone=api_zone burst=60 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 120s;
        }

        # ── Health check (no auth, no rate limit) ─────────────────
        location = /health {
            proxy_pass http://api/api/health;
            proxy_set_header Host $host;
        }

        location = /ready {
            proxy_pass http://api/api/ready;
            proxy_set_header Host $host;
        }

        # ── Nginx self-health (no upstream dependency) ────────────
        location = /nginx-health {
            access_log off;
            return 200 "ok\n";
            add_header Content-Type text/plain;
        }

        # ── OPDS catalog ───────────────────────────────────────────
        # auth_request is intentionally absent here. OPDS uses HTTP Basic Auth,
        # not the vault_session cookie. Every endpoint in routers/opds.py carries
        # a `require_opds_auth` FastAPI dependency that validates Basic Auth
        # credentials directly. Adding auth_request /_auth would break all OPDS
        # clients because /_auth only understands the cookie-based session.
        location /opds/ {
            limit_req zone=opds_zone burst=20 nodelay;
            proxy_pass http://api;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Authorization $http_authorization;
        }

        # ── Frontend PWA ──────────────────────────────────────────
        location / {
            proxy_pass http://pwa:3000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 60s;
        }
    }
}
